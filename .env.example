# Copie este arquivo para .env (na raiz do projeto) e preencha os valores reais.
# O .env está no .gitignore e NÃO deve ser versionado (contém credenciais).
# Este .env.example é o modelo versionado no Git — variáveis sem valores.

# ==== Credenciais de acesso ao portal de ponto eletrÃ´nico
USER=''
PASSWORD=''

# ==== URLs do portal de ponto eletrônico
URL_BASE=''
URL_DATA=''
URL_INIT=''
URL_PROFILE=''

# ==== Nome da pasta onde os arquivos gerados são salvos (versão Desktop)
NAME_FOLDER='PLANILHAS_SMS'
PATH_LOGO='assets/logo_pgm.png'

# ==== LOCALIZAÃ‡ÃƒO DA LISTA DAS UNIDADES DE SAÚDE COM SEUS CÓDIGOS ====
PATH_CSV='data/unidades.csv'

# ==== Usuarios da aplicacao web (nao e o login do portal) ====
# formato: user1:senha1,user2:senha2
WEB_USERS=''

# ==== Segredo para assinar o cookie de sessao (troque por um valor aleatorio)
SESSION_SECRET=''
SESSION_TTL_HOURS=12

# ==== Backend web: retencao e historico dos jobs ====
JOB_TTL_HOURS=24
JOBS_HISTORY_LIMIT=20

# ==== Frontend Angular (CORS) ====
# Origens permitidas para requests cross-origin (separadas por virgula)
# Exemplo: http://localhost,http://localhost:8080 
FRONTEND_URLS='http://localhost,http://localhost:8080'

# ==== JWT Spring Boot (auth federada) ====
# Segredo HMAC para validar tokens JWT emitidos pelo Spring Boot (mesmo valor do docker-ambiente/.env)
JWT_SECRET=''

# ==== reCAPTCHA (opcional) - resolucao automatica do captcha ====
# CAPTCHA_PROVIDER=''
# CAPTCHA_API_KEY=''

# ==== Opcionais (mantidos alinhados ao .env.example) ====
