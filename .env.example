# Copie este arquivo para .env (na raiz do projeto) e preencha os valores reais.
# O .env está no .gitignore e NÃO deve ser versionado (contém credenciais).
# Este .env.example é o modelo versionado no Git — variáveis sem valores.

# ---------------------------------------------------------------------------
# Credenciais de acesso ao portal de ponto eletrônico
# ---------------------------------------------------------------------------
USER=''
PASSWORD=''

# ---------------------------------------------------------------------------
# URLs do portal de ponto eletrônico
# ---------------------------------------------------------------------------
URL_BASE=''
URL_DATA=''
URL_INIT=''

# Nome da pasta onde os arquivos gerados são salvos
NAME_FOLDER=''

# ---------------------------------------------------------------------------
# Backend web (FASE 3): destino, retenção e histórico dos jobs
# ---------------------------------------------------------------------------
# Pasta base dos jobs (padrão: ~/Documents/<NAME_FOLDER>). Em testes/uso,
# pode apontar para outra pasta, ex.: OUTPUT_DIR='C:/tmp/ponto'
#OUTPUT_DIR=''
# Tempo de vida (horas) dos jobs concluídos antes da limpeza em disco (24-72h)
JOB_TTL_HOURS=
# Quantos jobs ficam no histórico navegável por usuário
JOBS_HISTORY_LIMIT=

# ---------------------------------------------------------------------------
# Backend web (FASE 4): contas da aplicação e sessão
# ---------------------------------------------------------------------------
# Usuários da aplicação web: formato "user1:senha1,user2:senha2".
# Não é o login do portal — são as contas de quem usa o sistema web.
# Use senhas fortes; nunca deixe valores de exemplo neste arquivo.
WEB_USERS=''
# Segredo usado para assinar o cookie de sessão. OBRIGATÓRIO em produção:
# se vazio, o backend usa um segredo EFÊMERO em memória (toda sessão é
# inválida a cada reinício do serviço — comportamento inseguro para produção).
# Gere uma chave fixa e cole aqui:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=''
# Tempo de vida (horas) da sessão web antes de exigir novo login
SESSION_TTL_HOURS=
# Atributo 'Secure' do cookie de sessão (enviado somente sobre HTTPS).
# Padrão false: a VM atual acessa via HTTP puro (http://<ip>:8000) — deixar
# como true nesse cenário quebraria o login. Ative apenas atrás de HTTPS.
# Valores aceitos: true|1|yes|on
SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Caminhos de recursos (relativos à raiz do projeto)
# ---------------------------------------------------------------------------
PATH_LOGO=''
PATH_CSV=''

# ---------------------------------------------------------------------------
# reCAPTCHA (opcional) - resolução automática transparente
# Sem API configurada, o módulo sinaliza "manual_required" quando
# o desafio de imagem abre. Preencha para resolução 100% automática.
# ---------------------------------------------------------------------------
# Provedor aceito: 2captcha | capsolver
CAPTCHA_PROVIDER=''
# Chave da API do provedor escolhido
CAPTCHA_API_KEY=''
# (opcional) A sitekey é detectada automaticamente no DOM; use apenas
# se a detecção automática falhar.
# CAPTCHA_SITEKEY=''

# ---------------------------------------------------------------------------
# Ghostscript (opcional) - compressão de PDF
# Se vazio, o backend tenta localizar automaticamente (PATH ou padrão do SO).
# ---------------------------------------------------------------------------
#GHOSTSCRIPT_BIN=''

# ---------------------------------------------------------------------------
# Dados de teste do endpoint /api/v1/ponto (somente para teste manual)
# Preencha apenas no .env local (LGPD: CPF não deve ir para o git).
# ---------------------------------------------------------------------------
TEST_PONTO_CPF=''
TEST_PONTO_UNIT=''
TEST_PONTO_MONTH_START=''
TEST_PONTO_YEAR_START=''
TEST_PONTO_MONTH_END=''
TEST_PONTO_YEAR_END=''
TEST_PONTO_EXCEL=
TEST_PONTO_PDF=